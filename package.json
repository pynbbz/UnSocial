{
  "name": "unsocial",
  "version": "1.13.0",
  "description": "Social media to RSS Feed converter - Desktop App",
  "main": "src/main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pynbbz/UnSocial"
  },
  "keywords": [
    "rss",
    "social-media",
    "instagram",
    "twitter",
    "facebook",
    "linkedin",
    "electron",
    "feed",
    "scraper"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npm version patch --no-git-tag-version && electron-builder --win",
    "build:minor": "npm version minor --no-git-tag-version && electron-builder --win",
    "build:major": "npm version major --no-git-tag-version && electron-builder --win",
    "build:current": "electron-builder --win",
    "build:mac": "npm version patch --no-git-tag-version && electron-builder --mac --arm64",
    "build:mac:minor": "npm version minor --no-git-tag-version && electron-builder --mac --arm64",
    "build:mac:major": "npm version major --no-git-tag-version && electron-builder --mac --arm64",
    "build:mac:current": "electron-builder --mac --arm64",
    "build:linux": "npm version patch --no-git-tag-version && electron-builder --linux",
    "build:linux:minor": "npm version minor --no-git-tag-version && electron-builder --linux",
    "build:linux:major": "npm version major --no-git-tag-version && electron-builder --linux",
    "build:linux:current": "electron-builder --linux"
  },
  "build": {
    "appId": "com.unsocial.app",
    "productName": "UnSocial",
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "UnSocial.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "UnSocial-data"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "UnSocial-${version}-arm64.${ext}"
    },
    "dmg": {
      "title": "UnSocial",
      "artifactName": "UnSocial-${version}-arm64.dmg"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "category": "Network",
      "artifactName": "UnSocial-${version}-${arch}.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "feed": "^4.2.2"
  },
  "devDependencies": {
    "electron": "^40.3.0",
    "electron-builder": "^26.7.0"
  }
}
